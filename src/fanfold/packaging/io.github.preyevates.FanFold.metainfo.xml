<component type="desktop-application">
  <id>io.github.preyevates.FanFold</id>
  <!-- Discover's PackageKit backend needs the native package name to associate this
       component with an installable or installed Debian package. -->
  <pkgname>fanfold</pkgname>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Fan Fold</name>
  <summary>Local-first Markdown notes at the screen edge</summary>
  <developer id="io.github.preyevates">
    <name>preyevates</name>
  </developer>
  <description>
    <p>
      Fan Fold edits ordinary Markdown files in a folder you choose. Notes are never copied
      into an application database, so the folder stays readable, searchable and syncable by
      any other tool.
    </p>
    <p>
      The window rests at the screen edge and fans your notes out as overlapping cards.
      Features include:
    </p>
    <ul>
      <li>A folder library with whole-library search</li>
      <li>Rich-text Markdown editing that works fully offline</li>
      <li>Autosave with conflict recovery</li>
      <li>Archive, restore and desktop trash</li>
      <li>Movable pinned note windows</li>
      <li>Per-note paper and ink colours, and global typography settings</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.preyevates.FanFold.desktop</launchable>
